{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "conexus": {
      "type": "local",
      "command": ["bunx", "@agentic-conexus/mcp"],
      "enabled": true,
      "environment": {
        "CONEXUS_PORT": "0",
        "CONEXUS_DB_PATH": "{env:CONEXUS_DB_PATH:./data/conexus.db}",
        "CONEXUS_LOG_LEVEL": "info"
      }
    }
  },
  "agent": {
    "typescript-pro": {
      "tools": {
        "conexus": true
      }
    },
    "frontend-developer": {
      "tools": {
        "conexus": true
      }
    },
    "conexus-expert": {
      "tools": {
        "conexus": true
      }
    }
  }
}